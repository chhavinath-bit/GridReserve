# GridReserve on the deploy host (M1.10). Template for /opt/gridreserve/.env, which lives only on the host
# (chmod 600) and is never committed. scripts/prod/init-env.sh fills every "generated" value with a random
# one and writes the file; you add the Google Drive token yourself. Only placeholders belong in this file.

# --- Release (set by scripts/prod/release.sh: the commit SHA whose images run) ---
IMAGE_TAG=
PREVIOUS_IMAGE_TAG=

# --- Public address ---
# Caddy gets a Let's Encrypt certificate for this name. sslip.io: the server's IP with dashes, no sign-up.
SITE_ADDRESS=203-0-113-5.sslip.io
# The same address with https://; refresh and logout accept only this Origin (FR-AUTH-12).
FRONTEND_ORIGIN=https://203-0-113-5.sslip.io

# --- PostgreSQL (generated) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=generated
POSTGRES_DB=postgres
IDENTITY_DB_USER=identity
IDENTITY_DB_PASSWORD=generated
BOOKING_DB_USER=booking
BOOKING_DB_PASSWORD=generated

# --- Token signing (generated on the host; the public key goes to gridreserve-config/application-prod.yml) ---
JWT_PRIVATE_KEY=generated

# --- Service-to-service credentials (D-19, generated) ---
BOOKING_SERVICE_CLIENT_SECRET=generated
BOOKING_SERVICE_CLIENT_SECRET_SHA256=generated

# --- Backups (docs/deploy/oracle.md, "Backups") ---
# Daily at this UTC time; 7 days kept here, 30 days off-site.
BACKUP_SCHEDULE=02:30
# rclone's Google Drive token (JSON on one line), from `rclone authorize "drive"` on your own computer.
RCLONE_GDRIVE_TOKEN=paste-here
# Encryption password and salt of the backups, rclone-obscured (generated). Keep a copy OFF this host, e.g. in
# a password manager: without them a backup cannot be decrypted, and a lost host takes this file with it.
RCLONE_CRYPT_PASSWORD=generated
RCLONE_CRYPT_SALT=generated
