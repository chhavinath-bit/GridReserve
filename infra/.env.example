# GridReserve local environment (dev).
# Copy to infra/.env and fill in your own values. infra/.env is git-ignored.
# Only placeholders belong in this file. Never commit real secrets.

# --- Profile ---
SPRING_PROFILES_ACTIVE=dev

# --- PostgreSQL superuser (used only by the container and the init script) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=postgres

# --- One database user per service (created by infra/postgres/init-databases.sh) ---
IDENTITY_DB_USER=identity
IDENTITY_DB_PASSWORD=change-me
BOOKING_DB_USER=booking
BOOKING_DB_PASSWORD=change-me

# --- Config Server ---
CONFIG_SERVER_URL=http://config-server:8888
# prod only (Git backend). In dev, Compose runs the config server with the "native" profile and
# mounts the sibling gridreserve-config folder instead.
CONFIG_REPO_URI=https://github.com/chhavinath-bit/gridreserve-config

# --- Identity service: RS256 private key for signing access tokens (PEM, single line with \n) ---
JWT_PRIVATE_KEY=change-me

# --- Gateway ---
APP_CORS_ORIGIN=http://localhost:5173
