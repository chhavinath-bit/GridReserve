<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot parent: manages versions of Spring, Jackson, Hibernate, Flyway, JUnit, Mockito, ... -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>com.gridreserve</groupId>
    <artifactId>gridreserve-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>GridReserve backend</name>
    <description>Parent build for all GridReserve backend modules</description>

    <modules>
        <module>libs/common-web</module>
        <module>platform/config-server</module>
        <module>platform/discovery-server</module>
        <module>platform/api-gateway</module>
        <module>services/identity-service</module>
        <module>services/booking-service</module>
        <!-- Tests against the running Compose stack; skipped unless -Psystem-tests (M1.8). -->
        <module>system-tests</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <!-- Must stay compatible with the Spring Boot version above (official Spring Cloud compatibility table). -->
        <spring-cloud.version>2025.1.4</spring-cloud.version>
    </properties>

    <!-- Versions only: nothing here is added to a module until the module declares it. -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.gridreserve</groupId>
                <artifactId>common-web</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!-- Runs *IT classes in the integration-test/verify phases (configured by the Boot parent).
                 Without it, Surefire runs only *Test classes and every *IT would be silently skipped. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
