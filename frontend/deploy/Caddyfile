# The public front door (M1.10, D-15): serves the built React app and passes /api to the gateway, so the
# browser sees one origin (the refresh cookie stays SameSite=Strict and no CORS is needed).
# SITE_ADDRESS decides TLS:
#   a hostname (e.g. 203-0-113-5.sslip.io) -> Caddy gets and renews a Let's Encrypt certificate by itself;
#   ":80" (default)                         -> plain HTTP, for the laptop demo behind a Cloudflare tunnel,
#                                              which provides HTTPS itself.
{
	# Nothing reconfigures Caddy at runtime, so its admin API stays off.
	admin off
}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# The gateway is the only backend the internet reaches (PLAT-01), and of its actuator only health.
	handle /actuator/health {
		reverse_proxy api-gateway:8080
	}
	handle /api/* {
		reverse_proxy api-gateway:8080
	}
	# Any other actuator path and anything internal: a plain 404, not the app's page.
	@private path /actuator/* /internal/*
	handle @private {
		respond 404
	}

	# The React app. Unknown paths get index.html, so client-side routes (/bookings, /venues/3) survive a reload.
	handle {
		root * /srv
		# Hashed file names never change content: cache them for a year; index.html must always be fresh.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header ?Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
